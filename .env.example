# Optional server and SQLite locations
# Local default. On Netlify the adapter is selected automatically when this is unset.
SFC_SQL_ADAPTER=sqlite
SFC_SQLITE_PATH=./.data/sfc.db
# PORT=5173
# HOST=127.0.0.1
# SFC_DATA_DIR=./.data
# REALTIME_DB_PATH=./realtime.db
# MAX_CONNECTIONS=2000
# DEV_HOST=127.0.0.1
# ENABLE_DEMO_SERVICES=false

# Example data-adapter credentials. Copy only the values your adapters use.
# DEPLOY_API_URL=https://deployments.example.com/api/
# DEPLOY_API_TOKEN=replace-me
# INVENTORY_DATABASE_URL=postgres://inventory:replace-me@database.internal/inventory
