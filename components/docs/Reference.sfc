sfc-reference-page .doc-table code { font-size: 10px; white-space: nowrap; }
sfc-reference-page .doc-table td:last-child code { white-space: normal; }
sfc-reference-page .doc-lead code, sfc-reference-page .doc-note code, sfc-reference-page .doc-hero code { padding: 1px 5px; color: #c4ff4d; border: 1px solid #293029; background: #101310; font: 10px ui-monospace, monospace; }
</style>
<route path="/reference" methods="GET" layout="sfc-doc-shell" layout-section="reference" />
