<style global>
  :root {
    --doc-bg: #0a0c0b;
    --doc-panel: #111411;
    --doc-panel-soft: #151915;
    --doc-line: #293029;
    --doc-text: #edf2e9;
    --doc-muted: #899388;
    --doc-accent: #c4ff4d;
    --doc-blue: #8edcff;
    --doc-orange: #ffb36b;
  }

  html, body { margin: 0; min-height: 100%; background: var(--doc-bg); color: var(--doc-text); }
  body { font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
  * { box-sizing: border-box; }
  html:not([data-sfc-demo-services="available"]) [data-demo-only] { display: none !important; }

  .doc-page { width: min(1120px, calc(100vw - 330px)); margin: 0 auto; padding: 66px 54px 110px; }
  .doc-breadcrumb { display: flex; align-items: center; gap: 10px; color: #687268; font: 700 9px/1 ui-monospace, monospace; letter-spacing: 1.4px; text-transform: uppercase; }
  .doc-breadcrumb i { width: 26px; height: 1px; background: var(--doc-accent); }
  .doc-hero { padding: 38px 0 58px; border-bottom: 1px solid var(--doc-line); }
  .doc-hero h1 { max-width: 850px; margin: 0; font: 500 clamp(48px, 7vw, 92px)/.94 Georgia, serif; letter-spacing: -4px; }
  .doc-hero h1 em { color: var(--doc-accent); font-weight: 400; }
  .doc-hero > p { max-width: 720px; margin: 25px 0 0; color: var(--doc-muted); font-size: 16px; line-height: 1.75; }
  .doc-meta { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 8px; }
  .doc-meta span { padding: 7px 9px; color: #9ca69b; border: 1px solid #303830; font: 700 8px/1 ui-monospace, monospace; letter-spacing: 1px; text-transform: uppercase; }

  .doc-toc { margin: 34px 0 64px; padding: 18px 22px; display: flex; flex-wrap: wrap; gap: 10px 24px; border: 1px solid var(--doc-line); background: rgba(17,20,17,.65); }
  .doc-toc b { color: #596359; font: 700 8px/1.6 ui-monospace, monospace; letter-spacing: 1.3px; }
  .doc-toc a { color: #aeb8ac; text-decoration: none; font-size: 10px; }.doc-toc a:hover { color: var(--doc-accent); }

  .doc-section { padding: 65px 0; border-bottom: 1px solid var(--doc-line); scroll-margin-top: 30px; }
  .doc-section:last-child { border-bottom: 0; }
  .doc-section-head { margin-bottom: 28px; display: grid; grid-template-columns: 70px 1fr; gap: 18px; }
  .doc-section-head > span { color: #596359; font: 800 11px/1 ui-monospace, monospace; letter-spacing: 1px; }
  .doc-section h2 { margin: -5px 0 10px; font: 400 clamp(30px, 4vw, 46px)/1 Georgia, serif; letter-spacing: -1.5px; }
  .doc-section h3 { margin: 28px 0 10px; color: #dbe1d8; font-size: 16px; }
  .doc-section p, .doc-section li { color: var(--doc-muted); font-size: 13px; line-height: 1.75; }
  .doc-section strong { color: #dce4d9; }.doc-section a { color: var(--doc-accent); }
  .doc-lead { max-width: 760px; margin: 0; color: #a5afa3 !important; font-size: 15px !important; }
  .doc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .doc-grid.three { grid-template-columns: repeat(3, 1fr); }
  .doc-card { padding: 24px; border: 1px solid var(--doc-line); background: linear-gradient(145deg, rgba(21,25,21,.9), rgba(13,16,13,.9)); }
  .doc-card > span { color: var(--doc-accent); font: 750 8px/1 ui-monospace, monospace; letter-spacing: 1.3px; }
  .doc-card h3 { margin: 15px 0 8px; }.doc-card p { margin: 0; font-size: 11px; }
  .doc-card ul { margin: 12px 0 0; padding-left: 16px; }.doc-card li { font-size: 11px; }

  .doc-code { margin: 25px 0; overflow: hidden; border: 1px solid #303830; background: #070907; box-shadow: 0 22px 55px rgba(0,0,0,.22); }
  .doc-code-head { height: 38px; padding: 0 14px; display: flex; align-items: center; justify-content: space-between; color: #657065; border-bottom: 1px solid #242a24; background: #101310; font: 700 8px/1 ui-monospace, monospace; letter-spacing: 1px; }
  .doc-code-head span::before { content: ''; width: 6px; height: 6px; margin-right: 8px; display: inline-block; border-radius: 50%; background: var(--doc-accent); box-shadow: 0 0 8px rgba(196,255,77,.4); }
  .doc-code pre { margin: 0; padding: 22px; overflow: auto; color: #c7d1c4; background: transparent; box-shadow: none; font: 12px/1.72 "SFMono-Regular", Consolas, monospace; tab-size: 2; }
  .doc-inline { padding: 2px 5px; color: #c9e98b; border: 1px solid #34402d; border-radius: 2px; background: #11170e; font: 11px ui-monospace, monospace; }
  .doc-note { margin: 24px 0; padding: 18px 20px; display: grid; grid-template-columns: auto 1fr; gap: 14px; border-left: 2px solid var(--doc-accent); background: #121711; }
  .doc-note > b { color: var(--doc-accent); font: 800 9px/1.6 ui-monospace, monospace; letter-spacing: 1px; }.doc-note p { margin: 0; font-size: 11px; }
  .doc-note.blue { border-color: var(--doc-blue); }.doc-note.blue > b { color: var(--doc-blue); }

  .doc-flow { margin: 28px 0; display: flex; align-items: stretch; gap: 0; }
  .doc-flow > div { min-width: 0; padding: 18px; flex: 1; border: 1px solid var(--doc-line); background: #101310; }
  .doc-flow > i { width: 28px; display: grid; place-items: center; color: var(--doc-accent); font-style: normal; }
  .doc-flow b { display: block; color: #dbe2d8; font-size: 11px; }.doc-flow span { display: block; margin-top: 5px; color: #697369; font: 8px/1.5 ui-monospace, monospace; }
  .doc-table { width: 100%; margin: 24px 0; border-collapse: collapse; font-size: 11px; }
  .doc-table th, .doc-table td { padding: 13px; text-align: left; border: 1px solid var(--doc-line); }.doc-table th { color: #778177; font: 700 8px ui-monospace, monospace; letter-spacing: 1px; }.doc-table td { color: #a7b0a5; }
  .doc-next { margin-top: 64px; padding: 26px; display: flex; align-items: center; justify-content: space-between; color: inherit; border: 1px solid #3b4635; background: linear-gradient(120deg, rgba(196,255,77,.08), transparent); text-decoration: none; }
  .doc-next span { color: #6f796e; font: 700 8px ui-monospace, monospace; letter-spacing: 1px; }.doc-next strong { display: block; margin-top: 6px; font: 400 22px Georgia, serif; }.doc-next i { color: var(--doc-accent); font-size: 24px; font-style: normal; }

  @media (max-width: 980px) { .doc-page { width: 100%; padding: 52px 34px 90px; }.doc-grid.three { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .doc-page { padding: 40px 20px 75px; }.doc-hero h1 { font-size: 48px; letter-spacing: -2.5px; }.doc-grid, .doc-grid.three { grid-template-columns: 1fr; }.doc-section-head { grid-template-columns: 42px 1fr; }.doc-flow { flex-direction: column; }.doc-flow > i { width: 100%; height: 26px; transform: rotate(90deg); }.doc-table { display: block; overflow-x: auto; } }
</style>
