<template>
  <div class="shell">
    <aside id="sidebar">
      <a class="logo" href="/basics" aria-label="SFC Framework home"><img src="/brand/sfc-mark.svg" alt="" width="50" height="50"><b>SFC</b><small>FRAMEWORK</small></a>
      <nav aria-label="Documentation sections">
        <p>LEARN</p>
        <a data-section="basics" href="/basics"><i>01</i><span>Framework basics<small>Frontend foundations</small></span></a>
        <a data-section="intermediate" href="/intermediate"><i>02</i><span>Intermediate<small>Backend introduction</small></span></a>
        <a data-section="advanced" href="/advanced"><i>03</i><span>Advanced<small>Full-stack patterns</small></span></a>
        <a data-section="internals" href="/internals"><i>04</i><span>Internals<small>Compiler & runtime</small></span></a>
        <p data-demo-only>BUILD & PROVE</p>
        <a data-demo-only data-section="playground" href="/playground"><i>05</i><span>Playground<small>Monaco + preview</small></span></a>
        <a data-demo-only data-section="stress" href="/stress-testing"><i>06</i><span>Stress testing<small>Realtime gauntlet</small></span></a>
      </nav>
      <div class="sidebar-foot"><i></i><span>NO VIRTUAL DOM<br><b>NATIVE BY DEFAULT</b></span></div>
    </aside>
    <div class="main">
      <header><button id="menu" aria-label="Toggle documentation menu" aria-expanded="false"><i></i><i></i></button><span>SFC DOCUMENTATION</span><a data-demo-only href="/playground">OPEN PLAYGROUND <svg aria-hidden="true" viewBox="0 0 24 24"><use href="/brand/icons.svg#arrow-up-right"></use></svg></a></header>
      <div class="progress"><i id="progress"></i></div>
      <slot></slot>
    </div>
  </div>
</template>

<script lang="ts">
export default class extends HTMLElement {
  static tag = 'sfc-doc-shell';
  static shadow = true;
  static observedAttributes = ['section'];
  private onScroll = () => {
    const max = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    const bar = this.shadowRoot?.querySelector('#progress') as HTMLElement | null;
    if (bar) bar.style.width = `${Math.min(100, scrollY / max * 100)}%`;
  };
  private onMenu = () => {
    const open = !this.hasAttribute('menu-open');
    this.toggleAttribute('menu-open', open);
    this.shadowRoot?.querySelector('#menu')?.setAttribute('aria-expanded', String(open));
  };
  private syncSection() {
    const section = this.getAttribute('section');
    this.shadowRoot?.querySelectorAll('[data-section]').forEach(link => {
      link.classList.toggle('active', link.getAttribute('data-section') === section);
    });
    this.removeAttribute('menu-open');
    this.shadowRoot?.querySelector('#menu')?.setAttribute('aria-expanded', 'false');
    this.onScroll();
  }
  private syncDemoAvailability() {
    const available = document.documentElement.dataset.sfcDemoServices === 'available';
    this.shadowRoot?.querySelectorAll('[data-demo-only]').forEach(element => {
      (element as HTMLElement).hidden = !available;
    });
  }
  connectedCallback() {
    this.syncDemoAvailability();
    this.syncSection();
    this.shadowRoot?.querySelector('#menu')?.addEventListener('click', this.onMenu);
    window.addEventListener('scroll', this.onScroll, { passive: true });
  }
  attributeChangedCallback(name: string, oldValue: string | null, newValue: string | null) {
    if (name === 'section' && oldValue !== newValue && this.isConnected) this.syncSection();
  }
  disconnectedCallback() {
    this.shadowRoot?.querySelector('#menu')?.removeEventListener('click', this.onMenu);
    window.removeEventListener('scroll', this.onScroll);
  }
}
</script>

<style>
:host { display: block; min-height: 100vh; }
* { box-sizing: border-box; }
.shell { min-height: 100vh; }
aside { width: 270px; height: 100vh; padding: 30px 20px 24px; position: fixed; inset: 0 auto 0 0; z-index: 50; display: flex; flex-direction: column; border-right: 1px solid #293029; background: rgba(10,12,11,.96); backdrop-filter: blur(18px); }
.logo { width: fit-content; height: 48px; display: grid; grid-template-columns: 46px auto; grid-template-rows: 24px 16px; color: #edf2e9; text-decoration: none; }
.logo img { width: 38px; height: 38px; grid-row: 1 / 3; transition: transform .18s ease; }
.logo:hover img { transform: translateY(-2px) rotate(-2deg); }
.logo:focus-visible { outline: 1px solid #c4ff4d; outline-offset: 5px; }
.logo b { align-self: end; font-size: 15px; letter-spacing: 3px; }.logo small { color: #657065; font: 700 7px ui-monospace, monospace; letter-spacing: 1.8px; }
nav { margin-top: 38px; display: flex; flex-direction: column; gap: 4px; }
nav p { margin: 18px 10px 7px; color: #4f594f; font: 800 7px ui-monospace, monospace; letter-spacing: 1.5px; }
nav a { padding: 11px 10px; display: grid; grid-template-columns: 27px 1fr; gap: 7px; color: #7d877d; border: 1px solid transparent; text-decoration: none; transition: .18s ease; }
nav a:hover { color: #c3cbc0; background: #111511; }nav a:focus-visible { outline: 1px solid #c4ff4d; }
nav a.active { color: #eff3ec; border-color: #35402f; background: linear-gradient(90deg, rgba(196,255,77,.09), transparent); }
nav a > i { padding-top: 2px; color: #4f594f; font: 700 8px ui-monospace, monospace; font-style: normal; }nav a.active > i { color: #c4ff4d; }
nav a span { font-size: 11px; font-weight: 700; }nav a small { margin-top: 3px; display: block; color: #596359; font: 7px ui-monospace, monospace; letter-spacing: .5px; }
.sidebar-foot { margin-top: auto; padding: 13px 10px; display: flex; align-items: center; gap: 10px; color: #5c665c; border-top: 1px solid #252b25; font: 7px/1.6 ui-monospace, monospace; letter-spacing: 1px; }.sidebar-foot i { width: 7px; height: 7px; border-radius: 50%; background: #c4ff4d; box-shadow: 0 0 9px rgba(196,255,77,.5); }.sidebar-foot b { color: #899388; }
.main { min-height: 100vh; margin-left: 270px; }
header { height: 58px; padding: 0 30px; position: sticky; top: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between; color: #626c62; border-bottom: 1px solid #252b25; background: rgba(10,12,11,.9); backdrop-filter: blur(16px); font: 750 8px ui-monospace, monospace; letter-spacing: 1.2px; }
header a { display: inline-flex; align-items: center; gap: 7px; color: #9da79b; text-decoration: none; }
header a svg { width: 12px; height: 12px; color: #c4ff4d; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
#menu { display: none; color: white; border: 0; background: transparent; }
.progress { height: 1px; position: sticky; top: 58px; z-index: 42; background: transparent; }.progress i { width: 0; height: 100%; display: block; background: #c4ff4d; box-shadow: 0 0 6px rgba(196,255,77,.5); }
@media (max-width: 980px) {
  aside { transform: translateX(-100%); transition: transform .22s; } :host([menu-open]) aside { transform: translateX(0); }
  .main { margin-left: 0; } #menu { width: 30px; height: 30px; display: flex; flex-direction: column; justify-content: center; gap: 5px; } #menu i { width: 18px; height: 1px; display: block; background: #cad2c7; }
}
</style>
