<template>
  <budget-shell page="settings">
    <main class="page">
      <header class="page-header"><div><p>MAKE IT YOURS</p><h1>Settings</h1><span>Manage your profile, preferences, and demo data.</span></div></header>
      <div id="toast" role="status"></div>
      <section class="settings-layout">
        <nav class="settings-nav"><button class="active" data-section="profile">Profile</button><button data-section="preferences">Preferences</button><button data-section="data">Data & privacy</button></nav>
        <div>
          <section class="settings-card active" data-panel="profile">
            <header><h2>Profile details</h2><p>Used to personalize your Clarity workspace.</p></header>
            <form id="profile-form">
              <div class="profile-photo"><span id="profile-avatar">AV</span><div><b>Your avatar</b><small>Generated from your initials</small></div></div>
              <label>Display name<input id="display-name" required maxlength="50"></label>
              <label>Email address<input id="profile-email" type="email" required></label>
              <div class="actions"><button class="primary" type="submit">Save changes</button></div>
            </form>
          </section>
          <section class="settings-card" data-panel="preferences">
            <header><h2>Preferences</h2><p>Choose how values and the interface appear.</p></header>
            <form id="preferences-form">
              <label>Currency<select id="currency"><option value="EUR">EUR — Euro</option><option value="USD">USD — US Dollar</option><option value="GBP">GBP — British Pound</option><option value="JPY">JPY — Japanese Yen</option></select></label>
              <fieldset><legend>Notifications</legend><label class="toggle"><span><b>Budget alerts</b><small>Tell me when a category reaches 80%.</small></span><input type="checkbox" checked><i></i></label><label class="toggle"><span><b>Weekly digest</b><small>A calm summary every Monday.</small></span><input type="checkbox" checked><i></i></label><label class="toggle"><span><b>Goal milestones</b><small>Celebrate when a goal crosses a milestone.</small></span><input type="checkbox"><i></i></label></fieldset>
              <div class="actions"><button class="primary" type="submit">Save preferences</button></div>
            </form>
          </section>
          <section class="settings-card" data-panel="data">
            <header><h2>Data & privacy</h2><p>Your demo data stays in this browser.</p></header>
            <div class="data-row"><span><b>Export your workspace</b><small>Download transactions, budgets, and goals as JSON.</small></span><button id="export-data">Export data</button></div>
            <div class="data-row"><span><b>Restore sample data</b><small>Replace your changes with the polished starter workspace.</small></span><button id="reset-data">Restore demo</button></div>
            <div class="data-row danger-row"><span><b>Sign out</b><small>End this browser session and return to the welcome screen.</small></span><button id="sign-out">Sign out</button></div>
          </section>
        </div>
      </section>
    </main>
  </budget-shell>
</template>

<script lang="ts">
import './Shell.sfc';
import { budgetAuth,budgetStore } from './store';
export default class extends HTMLElement{
 static tag='budget-settings';
   static shadow = true;
 connectedCallback(){if(!budgetAuth.require())return;Promise.resolve().then(()=>{this.bind();this.load()})}
 bind(){
  this.shadowRoot.querySelector('.settings-nav')?.addEventListener('click',e=>{const b=(e.target as HTMLElement).closest('[data-section]') as HTMLElement;if(!b)return;this.shadowRoot.querySelectorAll('[data-section]').forEach(x=>x.classList.toggle('active',x===b));this.shadowRoot.querySelectorAll('[data-panel]').forEach(x=>x.classList.toggle('active',(x as HTMLElement).dataset.panel===b.dataset.section))});
  this.shadowRoot.querySelector('#profile-form')?.addEventListener('submit',e=>this.saveProfile(e));this.shadowRoot.querySelector('#preferences-form')?.addEventListener('submit',e=>this.savePreferences(e));this.shadowRoot.querySelector('#export-data')?.addEventListener('click',()=>this.exportData());this.shadowRoot.querySelector('#reset-data')?.addEventListener('click',()=>this.reset());this.shadowRoot.querySelector('#sign-out')?.addEventListener('click',()=>{budgetAuth.signOut();location.href='/dashboard/login'});
 }
 load(){const session=budgetAuth.session(),state=budgetStore.get();(this.shadowRoot.querySelector('#display-name') as HTMLInputElement).value=session.name;(this.shadowRoot.querySelector('#profile-email') as HTMLInputElement).value=session.email;(this.shadowRoot.querySelector('#currency') as HTMLSelectElement).value=state.currency;this.avatar(session.name)}
 saveProfile(e){e.preventDefault();const name=(this.shadowRoot.querySelector('#display-name') as HTMLInputElement).value.trim(),email=(this.shadowRoot.querySelector('#profile-email') as HTMLInputElement).value.trim();budgetAuth.signIn(email,name);this.avatar(name);this.toast('Profile saved. Reloading the shell…');setTimeout(()=>location.reload(),500)}
 savePreferences(e){e.preventDefault();budgetStore.setCurrency((this.shadowRoot.querySelector('#currency') as HTMLSelectElement).value);this.toast('Preferences saved.')}
 avatar(name){const el=this.shadowRoot.querySelector('#profile-avatar');if(el)el.textContent=String(name).split(' ').filter(Boolean).slice(0,2).map(x=>x[0]).join('').toUpperCase()}
 exportData(){const blob=new Blob([JSON.stringify(budgetStore.get(),null,2)],{type:'application/json'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='clarity-workspace.json';a.click();URL.revokeObjectURL(a.href);this.toast('Workspace exported.')}
 reset(){if(confirm('Restore all sample transactions, budgets, and goals?')){budgetStore.reset();this.load();this.toast('Sample workspace restored.')}}
 toast(message){const el=this.shadowRoot.querySelector('#toast');el.textContent=message;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),2500)}
}
</script>

<style>
:host{display:block}*{box-sizing:border-box}.page{max-width:1200px;margin:auto;padding:38px 46px 70px;color:#17231e;font-family:Inter,ui-sans-serif,system-ui,sans-serif}.page-header{margin-bottom:25px}.page-header p{margin:0 0 5px;color:#839087;font-size:9px;font-weight:800;letter-spacing:1.5px}h1{margin:0 0 5px;font:400 36px Georgia,serif}.page-header span{color:#84918a;font-size:12px}
.settings-layout{display:grid;grid-template-columns:190px 1fr;gap:20px}.settings-nav{display:flex;flex-direction:column;gap:4px}.settings-nav button{padding:11px 13px;text-align:left;border:0;border-radius:8px;color:#6e7b74;background:transparent;font:650 10px Inter,sans-serif;cursor:pointer}.settings-nav button.active{color:#22543f;background:#e9f3e9}.settings-card{display:none;border:1px solid #e1e6e3;border-radius:14px;background:#fff;overflow:hidden}.settings-card.active{display:block}.settings-card>header{padding:21px 24px;border-bottom:1px solid #e8ece9}.settings-card h2{margin:0 0 5px;font:500 20px Georgia,serif}.settings-card header p{margin:0;color:#87938c;font-size:9px}.settings-card form{padding:24px}.profile-photo{margin-bottom:24px;display:flex;align-items:center;gap:12px}.profile-photo>span{width:54px;height:54px;display:grid;place-items:center;border-radius:16px;color:#fff;background:linear-gradient(135deg,#6b8c7f,#234d3d);font-weight:800}.profile-photo b,.profile-photo small{display:block;font-size:10px}.profile-photo small{margin-top:4px;color:#89958e;font-size:8px}
form>label{max-width:560px;display:grid;gap:7px;margin:15px 0;color:#455c50;font-size:10px;font-weight:750}input,select{padding:11px;border:1px solid #dbe2dd;border-radius:8px;background:#fff;font:inherit}.actions{margin:25px -24px -24px;padding:16px 24px;display:flex;justify-content:end;border-top:1px solid #e8ece9;background:#fafbfa}.primary{padding:10px 15px;border:0;border-radius:8px;color:#fff;background:#174d39;font-size:10px;font-weight:750;cursor:pointer}fieldset{margin:25px 0 0;padding:0;border:0}legend{margin-bottom:8px;font:500 14px Georgia,serif}.toggle{max-width:620px;padding:13px 0;display:grid;grid-template-columns:1fr auto;align-items:center;border-bottom:1px solid #edf0ee}.toggle b,.toggle small{display:block;font-size:10px}.toggle small{margin-top:3px;color:#8c9791;font-size:8px}.toggle input{position:absolute;opacity:0}.toggle i{width:34px;height:19px;padding:2px;display:block;border-radius:20px;background:#cad3ce}.toggle i:before{content:'';width:15px;height:15px;display:block;border-radius:50%;background:#fff;transition:transform .2s}.toggle input:checked+i{background:#367359}.toggle input:checked+i:before{transform:translateX(15px)}
.data-row{padding:20px 24px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #e8ece9}.data-row b,.data-row small{display:block;font-size:10px}.data-row small{margin-top:4px;color:#89958e;font-size:8px}.data-row button{padding:9px 13px;border:1px solid #dce3df;border-radius:8px;color:#385647;background:#fff;font-size:9px;font-weight:700;cursor:pointer}.danger-row b{color:#9b3e34}.danger-row button{color:#aa4036;border-color:#eccbc5}#toast{position:fixed;right:25px;top:20px;z-index:90;padding:11px 16px;border-radius:9px;color:white;background:#245842;box-shadow:0 10px 30px rgba(20,50,38,.2);font-size:10px;opacity:0;transform:translateY(-12px);pointer-events:none;transition:.2s}#toast.show{opacity:1;transform:none}
@media(max-width:650px){.page{padding:24px 16px}.settings-layout{grid-template-columns:1fr}.settings-nav{flex-direction:row;overflow:auto}.settings-nav button{white-space:nowrap}.page-header h1{font-size:29px}.data-row{gap:15px}.data-row small{max-width:200px}}
</style>

<route path="/dashboard/settings" methods="GET" />
