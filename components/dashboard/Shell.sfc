<template>
  <div class="shell">
    <aside class="sidebar" aria-label="Primary navigation">
      <a class="brand" href="/dashboard">
        <span class="brand-mark"><i></i><i></i><i></i></span>
        <span>Clarity</span>
      </a>
      <div class="workspace">
        <span class="avatar" id="shell-avatar">AV</span>
        <span><b id="shell-name">Alex van Dijk</b><small>Personal workspace</small></span>
        <button class="icon-button" aria-label="Workspace options">•••</button>
      </div>
      <nav>
        <p>Workspace</p>
        <a href="/dashboard" data-page="overview"><span>⌂</span>Overview</a>
        <a href="/dashboard/transactions" data-page="transactions"><span>⇄</span>Transactions</a>
        <a href="/dashboard/budgets" data-page="budgets"><span>◫</span>Budgets</a>
        <a href="/dashboard/goals" data-page="goals"><span>◇</span>Goals</a>
        <p>Manage</p>
        <a href="/dashboard/settings" data-page="settings"><span>⚙</span>Settings</a>
      </nav>
      <div class="sidebar-card">
        <span>PROGRESS</span>
        <b>Financially fluent</b>
        <div><i></i></div>
        <small>7 of 10 steps complete</small>
      </div>
      <button class="profile" id="profile-button">
        <span class="avatar small" id="shell-avatar-small">AV</span>
        <span><b id="shell-email">alex@example.com</b><small>View profile</small></span>
        <span>⌄</span>
      </button>
    </aside>
    <section class="stage">
      <header class="mobile-header">
        <a class="brand" href="/dashboard"><span class="brand-mark"><i></i><i></i><i></i></span>Clarity</a>
        <button id="menu-button" aria-label="Open navigation">☰</button>
      </header>
      <slot></slot>
    </section>
  </div>
</template>

<script lang="ts">
import { budgetAuth } from './store';

export default class extends HTMLElement {
  static tag = 'budget-shell';
  static shadow = true;
  menuHandler = () => this.shadowRoot?.querySelector('.sidebar')?.classList.toggle('open');

  connectedCallback() {
    Promise.resolve().then(() => {
      const page = this.getAttribute('page') || 'overview';
      this.shadowRoot?.querySelector(`[data-page="${page}"]`)?.classList.add('active');
      this.shadowRoot?.querySelector('#menu-button')?.addEventListener('click', this.menuHandler);
      const session = budgetAuth.session();
      if (!session) return;
      const initials = String(session.name || session.email).split(/\s|@/).filter(Boolean).slice(0, 2).map(part => part[0]).join('').toUpperCase();
      this.setText('#shell-name', session.name);
      this.setText('#shell-email', session.email);
      this.setText('#shell-avatar', initials);
      this.setText('#shell-avatar-small', initials);
    });
  }

  disconnectedCallback() {
    this.shadowRoot?.querySelector('#menu-button')?.removeEventListener('click', this.menuHandler);
  }

  setText(selector, value) {
    const element = this.shadowRoot?.querySelector(selector);
    if (element) element.textContent = value;
  }
}
</script>

<style>
:host { display: block; --ink: #17231e; --muted: #748079; --line: #e7ebe8; --green: #164f3b; --lime: #c7f36b; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: var(--ink); }
* { box-sizing: border-box; }
.shell { min-height: 100vh; background: #f6f8f6; display: grid; grid-template-columns: 252px minmax(0, 1fr); }
.sidebar { position: sticky; top: 0; height: 100vh; background: #fff; border-right: 1px solid var(--line); padding: 25px 18px 18px; display: flex; flex-direction: column; z-index: 30; }
.brand { display: flex; align-items: center; gap: 10px; padding: 0 9px; color: #173e30; text-decoration: none; font-size: 21px; font-weight: 800; letter-spacing: -.7px; }
.brand-mark { width: 27px; height: 27px; display: flex; align-items: end; gap: 2px; padding: 5px; border-radius: 8px; background: var(--green); transform: rotate(-4deg); }
.brand-mark i { display: block; width: 4px; border-radius: 3px; background: var(--lime); }
.brand-mark i:nth-child(1) { height: 7px; }.brand-mark i:nth-child(2) { height: 13px; }.brand-mark i:nth-child(3) { height: 10px; }
.workspace { margin: 28px 0 20px; padding: 10px; display: grid; grid-template-columns: auto 1fr auto; gap: 9px; align-items: center; border: 1px solid var(--line); border-radius: 12px; }
.workspace b, .profile b { display: block; max-width: 125px; overflow: hidden; text-overflow: ellipsis; font-size: 12px; white-space: nowrap; }
.workspace small, .profile small { display: block; color: var(--muted); font-size: 10px; margin-top: 2px; }
.avatar { width: 31px; height: 31px; display: grid; place-items: center; border-radius: 9px; color: #fff; font-weight: 800; font-size: 11px; background: linear-gradient(135deg, #6b8c7f, #234d3d); }
.avatar.small { width: 34px; height: 34px; border-radius: 50%; }
.icon-button { border: 0; background: transparent; color: var(--muted); cursor: pointer; }
nav p { margin: 16px 11px 7px; color: #9aa39e; font-size: 9px; font-weight: 800; text-transform: uppercase; letter-spacing: 1.3px; }
nav { display: block; position: static; top: auto; gap: 0; padding: 0; border-radius: 0; background: transparent; box-shadow: none; }
nav a { height: 42px; padding: 0 12px; display: flex; align-items: center; gap: 12px; color: #66716b; text-decoration: none; border-radius: 9px; font-size: 13px; font-weight: 650; }
nav a span { width: 18px; font-size: 17px; text-align: center; }
nav a:hover { background: #f3f7f4; color: var(--green); }
nav a.active { background: #eaf5e7; color: #164d38; }
.sidebar-card { margin-top: auto; padding: 14px; border: 1px solid #dce9dc; border-radius: 12px; background: linear-gradient(145deg, #f1fae8, #fff); }
.sidebar-card > span { color: #63806f; font-size: 8px; font-weight: 800; letter-spacing: 1px; }
.sidebar-card b { display: block; margin: 5px 0 9px; font-size: 12px; }
.sidebar-card div { height: 5px; overflow: hidden; border-radius: 9px; background: #dce8dc; }
.sidebar-card div i { display: block; width: 70%; height: 100%; background: #65a55c; }
.sidebar-card small { display: block; margin-top: 7px; color: var(--muted); font-size: 9px; }
.profile { width: 100%; margin-top: 13px; padding: 11px 7px 2px; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 9px; text-align: left; color: var(--ink); border: 0; border-top: 1px solid var(--line); background: transparent; cursor: pointer; }
.stage { min-width: 0; }
.mobile-header { display: none; }
@media (max-width: 860px) {
  .shell { grid-template-columns: 1fr; }
  .sidebar { position: fixed; left: -270px; width: 252px; box-shadow: 20px 0 50px rgba(20,50,38,.16); transition: left .25s ease; }
  .sidebar.open { left: 0; }
  .mobile-header { height: 64px; padding: 0 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--line); background: #fff; }
  .mobile-header button { border: 0; background: transparent; color: var(--green); font-size: 22px; }
}
</style>
