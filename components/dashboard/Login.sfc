<template>
  <main class="login-page">
    <section class="login-story">
      <a class="login-brand" href="/dashboard/login"><span>▥</span>Clarity</a>
      <div>
        <p class="eyebrow">MONEY, MADE MINDFUL</p>
        <h1>See the whole picture.<br><em>Shape what’s next.</em></h1>
        <p>One calm place for every transaction, plan, and milestone.</p>
        <div class="mini-chart" aria-label="Decorative rising balance chart">
          <svg viewBox="0 0 520 190" role="img">
            <defs><linearGradient id="area" x1="0" y1="0" x2="0" y2="1"><stop stop-color="#c7f36b" stop-opacity=".5"/><stop offset="1" stop-color="#c7f36b" stop-opacity="0"/></linearGradient></defs>
            <path class="area" d="M0 165 C80 154 93 114 160 126 S250 99 302 105 S383 42 520 27 L520 190 L0 190Z"/>
            <path class="line" d="M0 165 C80 154 93 114 160 126 S250 99 302 105 S383 42 520 27"/>
          </svg>
          <span>Cash flow</span><b>+18.4%</b>
        </div>
      </div>
      <small>Built with the custom SFC framework · 2026</small>
    </section>
    <section class="login-panel">
      <form id="login-form">
        <div class="mobile-brand">▥ Clarity</div>
        <p class="eyebrow">WELCOME BACK</p>
        <h2>Take control of your money.</h2>
        <p class="subhead">Use any email and a password of at least four characters to explore the demo.</p>
        <div id="login-message" role="status"></div>
        <label>Email address<input id="email" type="email" autocomplete="username" value="alex@clarity.demo" required></label>
        <label>Password<span class="password-wrap"><input id="password" type="password" autocomplete="current-password" value="demo1234" minlength="4" required><button type="button" id="toggle-password" aria-label="Show password">Show</button></span></label>
        <div class="form-row"><label class="check"><input type="checkbox" checked> Remember me</label><a href="#">Forgot password?</a></div>
        <button class="primary" type="submit">Enter your dashboard <span>→</span></button>
        <div class="divider"><span>or</span></div>
        <button class="secondary" type="button" id="demo-button">Continue with demo account</button>
        <p class="terms">New here? <button type="button" id="create-button">Create a free account</button></p>
      </form>
    </section>
  </main>
</template>

<script lang="ts">
import { budgetAuth } from './store';
export default class extends HTMLElement {
  static tag = 'budget-login';
    static shadow = true;
  connectedCallback() {
    Promise.resolve().then(() => {
      if (budgetAuth.session()) this.go();
      this.shadowRoot.querySelector('#login-form')?.addEventListener('submit', this.submit);
      this.shadowRoot.querySelector('#demo-button')?.addEventListener('click', this.demo);
      this.shadowRoot.querySelector('#create-button')?.addEventListener('click', this.create);
      this.shadowRoot.querySelector('#toggle-password')?.addEventListener('click', this.toggle);
    });
  }
  disconnectedCallback() {
    this.shadowRoot.querySelector('#login-form')?.removeEventListener('submit', this.submit);
    this.shadowRoot.querySelector('#demo-button')?.removeEventListener('click', this.demo);
    this.shadowRoot.querySelector('#create-button')?.removeEventListener('click', this.create);
    this.shadowRoot.querySelector('#toggle-password')?.removeEventListener('click', this.toggle);
  }
  submit = (event) => {
    event.preventDefault();
    const email = (this.shadowRoot.querySelector('#email') as HTMLInputElement).value.trim();
    const password = (this.shadowRoot.querySelector('#password') as HTMLInputElement).value;
    if (!email || password.length < 4) return this.message('Enter a valid email and password.', true);
    budgetAuth.signIn(email, email.split('@')[0].replace(/[._-]/g, ' '));
    this.go();
  };
  demo = () => { budgetAuth.signIn('alex@clarity.demo', 'Alex van Dijk'); this.go(); };
  create = () => { this.message('Demo account created — welcome to Clarity!'); budgetAuth.signIn('new@clarity.demo', 'New member'); setTimeout(() => this.go(), 500); };
  toggle = () => {
    const input = this.shadowRoot.querySelector('#password') as HTMLInputElement;
    const button = this.shadowRoot.querySelector('#toggle-password');
    input.type = input.type === 'password' ? 'text' : 'password';
    button.textContent = input.type === 'password' ? 'Show' : 'Hide';
  };
  message(value, error = false) { const el = this.shadowRoot.querySelector('#login-message'); el.textContent = value; el.className = error ? 'error' : 'success'; }
  go() {
    const next = new URLSearchParams(location.search).get('returnTo');
    location.href = next?.startsWith('/dashboard') ? next : '/dashboard';
  }
}
</script>

<style>
:host { display: block; min-height: 100vh; font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #193329; }
* { box-sizing: border-box; }
.login-page { min-height: 100vh; display: grid; grid-template-columns: 1.05fr .95fr; background: #f8faf8; }
.login-story { padding: 46px 7vw; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; color: #f8fff7; background: radial-gradient(circle at 70% 70%, #376d55 0, transparent 35%), linear-gradient(145deg, #173f31, #0b2f23); }
.login-brand { color: #fff; text-decoration: none; font-size: 22px; font-weight: 800; }
.login-brand span { margin-right: 9px; color: #c7f36b; }
.eyebrow { margin: 0 0 14px; color: #789083; font-size: 10px; font-weight: 800; letter-spacing: 2.2px; }
.login-story .eyebrow { color: #b5d3c1; }
.login-story h1 { max-width: 650px; margin: 0; color: #fff; font-family: Georgia, serif; font-size: clamp(42px, 5vw, 72px); font-weight: 400; line-height: 1.03; letter-spacing: -3px; }
.login-story h1 em { color: #c7f36b; font-weight: 400; }
.login-story > div > p:not(.eyebrow) { max-width: 450px; color: #c4d6ce; line-height: 1.7; }
.mini-chart { position: relative; max-width: 560px; margin-top: 40px; padding: 15px 18px 0; border: 1px solid rgba(255,255,255,.12); border-radius: 16px; background: rgba(255,255,255,.04); }
.mini-chart svg { width: 100%; display: block; }
.mini-chart .area { fill: url(#area); }.mini-chart .line { fill: none; stroke: #c7f36b; stroke-width: 3; }
.mini-chart span { position: absolute; top: 14px; left: 18px; color: #bcd0c6; font-size: 11px; }
.mini-chart b { position: absolute; top: 14px; right: 18px; color: #c7f36b; }
.login-story > small { color: #78988a; }
.login-panel { display: grid; place-items: center; padding: 50px 8vw; }
form { width: min(100%, 420px); }
form h2 { margin: 0 0 10px; font-family: Georgia, serif; font-size: 38px; font-weight: 500; letter-spacing: -1.2px; }
.subhead { margin: 0 0 30px; color: #78847e; font-size: 14px; line-height: 1.6; }
form > label { display: grid; gap: 8px; margin: 15px 0; color: #344a40; font-size: 12px; font-weight: 700; }
input { width: 100%; padding: 13px 14px; border: 1px solid #d9e1dc; border-radius: 9px; outline: none; background: #fff; font: inherit; }
input:focus { border-color: #3c745d; box-shadow: 0 0 0 3px #dcece3; }
.password-wrap { position: relative; }
.password-wrap button { position: absolute; top: 0; right: 0; height: 100%; padding: 0 13px; border: 0; color: #466256; background: transparent; cursor: pointer; font-size: 11px; }
.form-row { margin: 17px 0; display: flex; justify-content: space-between; font-size: 11px; }
.form-row a { color: #226247; }
.check { display: flex; align-items: center; gap: 7px; color: #65736c; }
.check input { width: auto; accent-color: #1e5c42; }
.primary, .secondary { width: 100%; padding: 14px 18px; border-radius: 9px; cursor: pointer; font-weight: 750; }
.primary { display: flex; justify-content: space-between; border: 0; color: #fff; background: #174b38; }
.primary:hover { background: #0e3828; }
.secondary { border: 1px solid #d9e1dc; color: #34483f; background: #fff; }
.divider { margin: 20px 0; display: flex; align-items: center; gap: 12px; color: #98a29d; font-size: 10px; }
.divider::before, .divider::after { content: ''; height: 1px; flex: 1; background: #e3e8e5; }
.terms { text-align: center; color: #7a8680; font-size: 11px; }
.terms button { border: 0; color: #226247; background: transparent; font-weight: 700; cursor: pointer; }
#login-message { min-height: 0; font-size: 12px; }.error, .success { margin-bottom: 12px; padding: 10px; border-radius: 8px; }
.error { color: #922b24; background: #fff0ee; }.success { color: #17613f; background: #eaf8ef; }
.mobile-brand { display: none; }
@media (max-width: 800px) {
  .login-page { grid-template-columns: 1fr; }
  .login-story { display: none; }
  .login-panel { min-height: 100vh; padding: 35px 24px; }
  .mobile-brand { display: block; margin-bottom: 50px; color: #174b38; font-size: 20px; font-weight: 800; }
}
</style>

<route path="/dashboard/login" methods="GET" />
