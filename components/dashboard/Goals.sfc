<template>
  <budget-shell page="goals">
    <main class="page">
      <header class="page-header"><div><p>MAKE IT REAL</p><h1>Savings goals</h1><span>Turn far-off dreams into small, visible steps.</span></div><button class="primary" id="new-goal">+ Create goal</button></header>
      <section class="goal-summary"><div><span>YOUR GOAL MOMENTUM</span><strong id="total-saved">€0</strong><small>saved toward <b id="goal-count">0 goals</b></small></div><blockquote>“A goal without a plan is just a wish.”<cite>— Antoine de Saint-Exupéry</cite></blockquote></section>
      <section class="goal-grid" id="goal-grid"></section>
      <dialog id="goal-dialog">
        <form id="goal-form">
          <header><div><p>MILESTONE</p><h2 id="dialog-title">Create a goal</h2></div><button type="button" id="close-dialog">×</button></header>
          <input id="goal-id" type="hidden">
          <div class="form-grid"><label>Icon<select id="emoji"><option>✈️</option><option>🏡</option><option>🛟</option><option>🖥️</option><option>🚲</option><option>🎓</option><option>💍</option></select></label><label>Goal name<input id="name" required maxlength="40" placeholder="My next adventure"></label></div>
          <div class="form-grid"><label>Target amount<input id="target" type="number" min="1" step="1" required></label><label>Already saved<input id="saved" type="number" min="0" step="1" required value="0"></label></div>
          <label>Target date<input id="deadline" type="date" required></label>
          <div class="dialog-actions"><button class="danger" type="button" id="delete-goal">Delete</button><button class="secondary" type="button" id="cancel-dialog">Cancel</button><button class="primary" type="submit">Save goal</button></div>
        </form>
      </dialog>
    </main>
  </budget-shell>
</template>

<script lang="ts">
import './Shell.sfc';
import { budgetAuth,budgetStore,money,escapeHtml,uid,dateLabel } from './store';
export default class extends HTMLElement{
 static tag='budget-goals';
   static shadow = true;
 connectedCallback(){if(!budgetAuth.require())return;Promise.resolve().then(()=>{this.bind();this.render()})}
 bind(){this.shadowRoot.querySelector('#new-goal')?.addEventListener('click',()=>this.open());this.shadowRoot.querySelector('#goal-grid')?.addEventListener('click',e=>{const b=(e.target as HTMLElement).closest('[data-id]') as HTMLElement;if(b)this.open(budgetStore.get().goals.find(g=>g.id===b.dataset.id))});this.shadowRoot.querySelector('#close-dialog')?.addEventListener('click',()=>this.close());this.shadowRoot.querySelector('#cancel-dialog')?.addEventListener('click',()=>this.close());this.shadowRoot.querySelector('#goal-form')?.addEventListener('submit',e=>this.save(e));this.shadowRoot.querySelector('#delete-goal')?.addEventListener('click',()=>this.remove())}
 render(){const s=budgetStore.get(),total=s.goals.reduce((a,g)=>a+g.saved,0);this.text('#total-saved',money(total,s.currency));this.text('#goal-count',`${s.goals.length} goal${s.goals.length===1?'':'s'}`);this.shadowRoot.querySelector('#goal-grid').innerHTML=s.goals.map((g,i)=>{const p=Math.min(100,g.saved/g.target*100),left=Math.max(0,g.target-g.saved);return `<button class="goal-card ${i===0?'featured':''}" data-id="${g.id}"><header><span>${escapeHtml(g.emoji)}</span><i>•••</i></header><p>GOAL ${String(i+1).padStart(2,'0')}</p><h2>${escapeHtml(g.name)}</h2><div class="ring" style="--progress:${p*3.6}deg"><span><b>${Math.round(p)}%</b><small>funded</small></span></div><div class="numbers"><span><small>Saved</small><b>${escapeHtml(money(g.saved,s.currency))}</b></span><span><small>Still needed</small><b>${escapeHtml(money(left,s.currency))}</b></span></div><footer>Target · ${escapeHtml(dateLabel(g.deadline))}</footer></button>`}).join('')+`<button class="goal-card new" id="inline-new"><span>+</span><b>Start a new dream</b><small>Every big thing begins somewhere.</small></button>`;this.shadowRoot.querySelector('#inline-new')?.addEventListener('click',()=>this.open())}
 open(g=null){const f=this.shadowRoot.querySelector('#goal-form') as HTMLFormElement;f.reset();(this.shadowRoot.querySelector('#goal-id') as HTMLInputElement).value=g?.id||'';(this.shadowRoot.querySelector('#emoji') as HTMLSelectElement).value=g?.emoji||'✈️';(this.shadowRoot.querySelector('#name') as HTMLInputElement).value=g?.name||'';(this.shadowRoot.querySelector('#target') as HTMLInputElement).value=g?.target||'';(this.shadowRoot.querySelector('#saved') as HTMLInputElement).value=g?.saved||'0';const d=new Date();d.setMonth(d.getMonth()+6);(this.shadowRoot.querySelector('#deadline') as HTMLInputElement).value=g?.deadline||d.toISOString().slice(0,10);this.text('#dialog-title',g?'Edit goal':'Create a goal');(this.shadowRoot.querySelector('#delete-goal') as HTMLElement).style.display=g?'block':'none';(this.shadowRoot.querySelector('#goal-dialog') as HTMLDialogElement).showModal()}
 close(){(this.shadowRoot.querySelector('#goal-dialog') as HTMLDialogElement).close()}
 save(e){e.preventDefault();budgetStore.saveGoal({id:(this.shadowRoot.querySelector('#goal-id') as HTMLInputElement).value||uid(),emoji:(this.shadowRoot.querySelector('#emoji') as HTMLSelectElement).value,name:(this.shadowRoot.querySelector('#name') as HTMLInputElement).value.trim(),target:Number((this.shadowRoot.querySelector('#target') as HTMLInputElement).value),saved:Number((this.shadowRoot.querySelector('#saved') as HTMLInputElement).value),deadline:(this.shadowRoot.querySelector('#deadline') as HTMLInputElement).value});this.close();this.render()}
 remove(){const id=(this.shadowRoot.querySelector('#goal-id') as HTMLInputElement).value;if(id&&confirm('Delete this savings goal?')){budgetStore.deleteGoal(id);this.close();this.render()}}
 text(s,v){const e=this.shadowRoot.querySelector(s);if(e)e.textContent=v}
}
</script>

<style>
:host{display:block}*{box-sizing:border-box}.page{max-width:1500px;margin:auto;padding:38px 46px 70px;color:#17231e;font-family:Inter,ui-sans-serif,system-ui,sans-serif}.page-header{display:flex;justify-content:space-between;align-items:end;margin-bottom:24px}.page-header p,.goal-card>p,dialog p{margin:0 0 5px;color:#839087;font-size:9px;font-weight:800;letter-spacing:1.5px}h1{margin:0 0 5px;font:400 36px Georgia,serif}.page-header span{color:#84918a;font-size:12px}button{font:inherit;cursor:pointer}.primary{padding:11px 16px;border:0;border-radius:9px;color:white;background:#174d39;font-size:11px;font-weight:750}
.goal-summary{padding:22px 28px;display:flex;justify-content:space-between;align-items:center;border-radius:14px;color:#fff;background:linear-gradient(120deg,#164332,#2f6d50)}.goal-summary span{color:#b2cdbf;font-size:8px;font-weight:800;letter-spacing:1.4px}.goal-summary strong{display:block;margin:4px 0;font:500 31px Georgia,serif}.goal-summary small{color:#a9c5b7;font-size:9px}.goal-summary blockquote{max-width:360px;margin:0;color:#d8e8df;font:italic 16px Georgia,serif}.goal-summary cite{display:block;margin-top:7px;color:#9cbbaa;font:normal 8px Inter,sans-serif}
.goal-grid{margin-top:15px;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.goal-card{min-height:345px;padding:20px;text-align:left;border:1px solid #e1e6e3;border-radius:14px;color:#17231e;background:#fff}.goal-card:hover{transform:translateY(-2px);box-shadow:0 10px 25px rgba(20,55,40,.07)}.goal-card.featured{border-color:#c7d8ca;background:linear-gradient(160deg,#f5fbef,#fff)}.goal-card header{display:flex;justify-content:space-between}.goal-card header>span{width:39px;height:39px;display:grid;place-items:center;border-radius:12px;background:#eef5eb;font-size:20px}.goal-card header i{color:#9aa39e;font-style:normal}.goal-card>p{margin-top:15px}.goal-card h2{margin:0;text-align:left;font:500 19px Georgia,serif}.ring{width:115px;aspect-ratio:1;margin:17px auto;display:grid;place-items:center;border-radius:50%;background:conic-gradient(#4d8b68 var(--progress),#e8eeea 0)}.ring:before{content:'';width:82px;aspect-ratio:1;grid-area:1/1;border-radius:50%;background:#fff}.ring span{z-index:1;grid-area:1/1;text-align:center}.ring b{display:block;font:500 19px Georgia,serif}.ring small{color:#8d9892;font-size:8px}.numbers{display:grid;grid-template-columns:1fr 1fr;gap:10px}.numbers span:last-child{text-align:right}.numbers small{display:block;color:#929c97;font-size:8px}.numbers b{font-size:10px}.goal-card footer{margin-top:17px;padding-top:12px;border-top:1px solid #e8ece9;color:#7e8b84;text-align:center;font-size:8px}.goal-card.new{display:grid;place-content:center;place-items:center;gap:7px;text-align:center;border-style:dashed;background:transparent}.goal-card.new>span{width:42px;height:42px;display:grid;place-items:center;border-radius:50%;color:#2d674e;background:#e9f2eb;font-size:23px}.goal-card.new b{font:500 16px Georgia,serif}.goal-card.new small{color:#89958e;font-size:9px}
dialog{width:min(500px,calc(100vw - 30px));max-width:500px;padding:0;overflow-x:hidden;border:0;border-radius:16px;color:#193127;box-shadow:0 30px 80px rgba(20,50,38,.25)}dialog::backdrop{background:rgba(13,34,26,.48);backdrop-filter:blur(3px)}dialog form{display:block;width:100%;min-width:0;margin:0;padding:25px}dialog header{width:100%;display:flex;justify-content:space-between}dialog h2{margin:0 0 16px;font:500 25px Georgia,serif}dialog header button{border:0;color:#78857e;background:transparent;font-size:24px}.form-grid{width:100%;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:12px}.form-grid:nth-of-type(2){grid-template-columns:minmax(0,1fr) minmax(0,1fr)}dialog label{min-width:0;display:grid;gap:7px;margin:12px 0;color:#455c50;font-size:10px;font-weight:750}dialog input,dialog select{width:100%;padding:11px;border:1px solid #dbe2dd;border-radius:8px;background:white;font:inherit}.dialog-actions{margin-top:20px;display:flex;justify-content:end;gap:8px}.secondary,.danger{padding:10px 14px;border:1px solid #dce3df;border-radius:8px;background:white;font-size:10px;font-weight:700}.danger{margin-right:auto;color:#b04437;border-color:#efcfc9}
@media(max-width:1150px){.goal-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.page{padding:24px 16px}.goal-grid{grid-template-columns:1fr}.goal-summary blockquote{display:none}.page-header>div>span{display:none}.page-header h1{font-size:29px}.page-header .primary{font-size:0}.page-header .primary:first-letter{font-size:16px}dialog form{padding:20px}.form-grid,.form-grid:nth-of-type(2){grid-template-columns:1fr}}
</style>

<route path="/dashboard/goals" methods="GET" />
